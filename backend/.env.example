# Optica Luxe - Backend Environment Configuration (Production Template)
NODE_ENV=production
PORT=5000

# Primary PostgreSQL Database (MANDATORY in production, fails fast if offline)
DATABASE_URL=postgresql://app_user:REPLACE_WITH_STRONG_DB_PASSWORD@db-host:5432/optica_luxe_prod?schema=public

# Optional Isolated PostgreSQL Test Database (For running real live integration concurrency tests)
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/optica_test_db?schema=public

# JWT Authentication (Must be at least 32 characters, high entropy, never committed to git)
JWT_SECRET=REPLACE_WITH_MINIMUM_32_CHARACTERS_HIGH_ENTROPY_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=7d

# Initial Production Administrator Bootstrap (STRICTLY REQUIRED in production, min 12 chars)
ADMIN_EMAIL=security-admin@optica-luxe.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_MIN_12_CHARS
ADMIN_NAME=Store Administrator

# Security & CORS Allowlist (Comma-separated origins, no wildcards with credentials, no localhost in production)
CORS_ORIGIN=https://optica-luxe.com
CORS_ALLOWED_ORIGINS=https://optica-luxe.com,https://admin.optica-luxe.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=60
