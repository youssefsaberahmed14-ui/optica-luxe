# Optica Luxe - Backend Environment Configuration (Production Template)
NODE_ENV=production
PORT=5000

# Database Connection (PostgreSQL is required in production)
DATABASE_URL=postgresql://user:STRONG_SECURE_PASSWORD@localhost:5432/optica_luxe_prod?schema=public

# JWT Authentication (Must be at least 32 characters, high entropy, never committed)
JWT_SECRET=REPLACE_WITH_MINIMUM_32_CHARACTERS_HIGH_ENTROPY_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=7d

# Initial Administrator Provisioning (Optional for setup script)
ADMIN_EMAIL=security-admin@optica-luxe.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_MIN_12_CHARS
ADMIN_NAME=Store Administrator

# Security & CORS
CORS_ORIGIN=https://optica-luxe.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=10
